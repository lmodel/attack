	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixTimestamp"^^xsd:anyURI ;
	linkml:description "An RFC 3339 timestamp in UTC, ending in Z, with any precision of fractional seconds." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)(\\.[0-9]+)?Z$" ;
	linkml:typeof <https://w3id.org/lmodel/attack/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/attack/stix_timestamp_millis> a linkml:TypeDefinition ;
