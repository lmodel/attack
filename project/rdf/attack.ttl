	linkml:definition_uri "https://w3id.org/lmodel/stix/StixTimestampMillis"^^xsd:anyURI ;
	linkml:description "A timestamp precise to the millisecond or finer: at least three digits of fractional seconds, as STIX requires of created and modified." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)\\.[0-9]{3,}Z$" ;
	linkml:typeof <https://w3id.org/lmodel/attack/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/attack/stix_timestamp_seconds> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/stix/stix_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/stix/StixTimestampSeconds"^^xsd:anyURI ;
	linkml:description "A timestamp precise to the second, with no fractional seconds." ;
	linkml:pattern "^[0-9]{4}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)Z$" ;
	linkml:typeof <https://w3id.org/lmodel/attack/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
