      "pattern": "^(ipv4-addr|ipv6-addr|mac-addr|domain-name)--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "any_of": [
        {
          "range": "StixIpv4Address",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixIpv6Address",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixMacAddress",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixDomainName",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "src_port",
      "definition_uri": "https://w3id.org/lmodel/stix/src_port",
      "description": "Specifies the source port used in the network traffic, as an integer. The port value MUST be in the range of 0 - 65535.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/src_port"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/src_port",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "integer",
      "minimum_value": 0,
      "maximum_value": 65535,
      "@type": "SlotDefinition"
    },
    {
      "name": "dst_port",
      "definition_uri": "https://w3id.org/lmodel/stix/dst_port",
      "description": "Specifies the destination port used in the network traffic, as an integer. The port value MUST be in the range of 0 - 65535.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/dst_port"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/dst_port",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "integer",
      "minimum_value": 0,
      "maximum_value": 65535,
      "@type": "SlotDefinition"
    },
    {
      "name": "protocols",
      "definition_uri": "https://w3id.org/lmodel/stix/protocols",
