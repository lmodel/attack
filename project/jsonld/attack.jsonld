      ],
      "slot_uri": "https://w3id.org/lmodel/stix/bcc_refs",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "StixEmailAddress",
      "multivalued": true,
      "pattern": "^email-addr--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "message_id",
      "definition_uri": "https://w3id.org/lmodel/stix/message_id",
      "description": "Specifies the Message-ID field of the email message.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/message_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/message_id",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "subject",
      "definition_uri": "https://w3id.org/lmodel/stix/subject",
      "description": "A subject, as a string; each class says of what.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/subject"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/subject",
      "owner": "StixX509Certificate",
      "domain_of": [
        "StixEmailMessage",
        "StixX509Certificate"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "received_lines",
      "definition_uri": "https://w3id.org/lmodel/stix/received_lines",
      "description": "Specifies one or more Received header fields that may be included in the email headers.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/received_lines"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/received_lines",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "string",
      "multivalued": true,
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "additional_header_fields",
      "definition_uri": "https://w3id.org/lmodel/stix/additional_header_fields",
      "description": "Specifies any other header fields found in the email message, as a dictionary.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/additional_header_fields"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/additional_header_fields",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "StixDictionary",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "raw_email_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/raw_email_ref",
      "description": "Specifies the raw binary contents of the email message, including both the headers and body, as a reference to an Artifact Object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/raw_email_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/raw_email_ref",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "StixArtifact",
      "pattern": "^artifact--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_multipart",
      "definition_uri": "https://w3id.org/lmodel/stix/is_multipart",
      "description": "Indicates whether the email body contains multiple MIME parts.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/is_multipart"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/is_multipart",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "body",
      "definition_uri": "https://w3id.org/lmodel/stix/body",
      "description": "A body of text.",
