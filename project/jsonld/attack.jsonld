      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "analysis_definition_version",
      "definition_uri": "https://w3id.org/lmodel/stix/analysis_definition_version",
      "description": "The version of the analysis definitions used by the analysis tool.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/analysis_definition_version"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/analysis_definition_version",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "submitted",
      "definition_uri": "https://w3id.org/lmodel/stix/submitted",
      "description": "The date and time that this malware was first submitted for scanning or analysis.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/submitted"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/submitted",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "analysis_started",
      "definition_uri": "https://w3id.org/lmodel/stix/analysis_started",
      "description": "The date and time that the malware analysis was initiated.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/analysis_started"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/analysis_started",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "analysis_ended",
      "definition_uri": "https://w3id.org/lmodel/stix/analysis_ended",
      "description": "The date and time that the malware analysis ended.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/analysis_ended"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/analysis_ended",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "result_name",
      "definition_uri": "https://w3id.org/lmodel/stix/result_name",
      "description": "The classification result or name assigned to the malware instance by the scanner tool.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/result_name"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/result_name",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "result",
      "definition_uri": "https://w3id.org/lmodel/stix/result",
      "description": "The classification result as determined by the scanner or tool analysis process.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/result"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/result",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "string",
      "any_of": [
        {
          "range": "StixMalwareResult",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "host_vm_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/host_vm_ref",
      "description": "A description of the virtual machine environment used to host the guest operating system (if applicable) that was used for the dynamic analysis of the malware instance or family.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/host_vm_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/host_vm_ref",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "StixSoftware",
      "pattern": "^software--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "operating_system_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/operating_system_ref",
      "description": "The operating system that was used to perform the dynamic analysis.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/operating_system_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/operating_system_ref",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "StixSoftware",
      "pattern": "^software--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "installed_software_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/installed_software_refs",
      "description": "Any non-standard software installed on the operating system used for the dynamic analysis of the malware instance or family.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/installed_software_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/installed_software_refs",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "StixSoftware",
      "multivalued": true,
      "pattern": "^software--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "analysis_sco_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/analysis_sco_refs",
      "description": "The list of STIX objects that were captured during the analysis process.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/analysis_sco_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/analysis_sco_refs",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "StixCyberObservableObject",
      "multivalued": true,
      "pattern": "^[a-z][a-z0-9-]+[a-z0-9]--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "sample_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/sample_ref",
      "description": "Refers to the object this analysis was performed against.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/sample_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/sample_ref",
      "owner": "StixMalwareAnalysis",
      "domain_of": [
        "StixMalwareAnalysis"
      ],
      "range": "StixCyberObservableObject",
      "pattern": "^(file|network-traffic|artifact)--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "any_of": [
        {
          "range": "StixFile",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixNetworkTraffic",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixArtifact",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "abstract",
      "definition_uri": "https://w3id.org/lmodel/stix/abstract",
      "description": "A brief summary of the note.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/abstract"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/abstract",
      "owner": "StixNote",
      "domain_of": [
        "StixNote"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "content",
      "definition_uri": "https://w3id.org/lmodel/stix/content",
      "description": "The content of the note.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/content"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/content",
      "owner": "StixNote",
      "domain_of": [
        "StixNote"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "authors",
      "definition_uri": "https://w3id.org/lmodel/stix/authors",
      "description": "The name of the author(s) of this note (e.g., the analyst(s) that created it).",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/authors"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/authors",
      "owner": "StixOpinion",
      "domain_of": [
        "StixNote",
        "StixOpinion"
      ],
      "range": "string",
      "multivalued": true,
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "first_observed",
      "definition_uri": "https://w3id.org/lmodel/stix/first_observed",
      "description": "The beginning of the time window that the data was observed during.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/first_observed"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/first_observed",
      "owner": "StixObservedData",
      "domain_of": [
        "StixObservedData"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "last_observed",
      "definition_uri": "https://w3id.org/lmodel/stix/last_observed",
      "description": "The end of the time window that the data was observed during.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/last_observed"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/last_observed",
      "owner": "StixObservedData",
      "domain_of": [
        "StixObservedData"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "number_observed",
      "definition_uri": "https://w3id.org/lmodel/stix/number_observed",
      "description": "The number of times the data represented in the objects property was observed. This MUST be an integer between 1 and 999,999,999 inclusive.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/number_observed"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/number_observed",
      "owner": "StixObservedData",
      "domain_of": [
        "StixObservedData"
      ],
      "range": "integer",
      "minimum_value": 1,
      "maximum_value": 999999999,
      "@type": "SlotDefinition"
    },
    {
      "name": "explanation",
      "definition_uri": "https://w3id.org/lmodel/stix/explanation",
      "description": "An explanation of why the producer has this Opinion.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/explanation"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/explanation",
      "owner": "StixOpinion",
      "domain_of": [
        "StixOpinion"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "opinion",
      "definition_uri": "https://w3id.org/lmodel/stix/opinion",
      "description": "The opinion that the producer has about about all of the STIX Object(s) listed in the object_refs property.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/opinion"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/opinion",
      "owner": "StixOpinion",
      "domain_of": [
        "StixOpinion"
      ],
      "range": "StixAgreement",
      "@type": "SlotDefinition"
    },
    {
      "name": "report_types",
      "definition_uri": "https://w3id.org/lmodel/stix/report_types",
      "description": "This field is an Open Vocabulary that specifies the primary subject of this report. The suggested values for this field are in report-type-ov.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/report_types"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/report_types",
      "owner": "StixReport",
      "domain_of": [
        "StixReport"
      ],
      "range": "string",
      "multivalued": true,
      "minimum_cardinality": 1,
      "any_of": [
        {
          "range": "StixReportType",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "published",
      "definition_uri": "https://w3id.org/lmodel/stix/published",
      "description": "The date that this report object was officially published by the creator of this report.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/published"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/published",
      "owner": "StixReport",
      "domain_of": [
        "StixReport"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "threat_actor_types",
      "definition_uri": "https://w3id.org/lmodel/stix/threat_actor_types",
      "description": "This field specifies the type of threat actor. Open Vocab - threat-actor-type-ov.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/threat_actor_types"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/threat_actor_types",
      "owner": "StixThreatActor",
      "domain_of": [
        "StixThreatActor"
      ],
      "range": "string",
      "multivalued": true,
      "minimum_cardinality": 1,
      "any_of": [
        {
          "range": "StixThreatActorType",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "sophistication",
      "definition_uri": "https://w3id.org/lmodel/stix/sophistication",
      "description": "The skill, specific knowledge, special training, or expertise a Threat Actor must have to perform the attack. Open Vocab - threat-actor-sophistication-ov.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/sophistication"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/sophistication",
      "owner": "StixThreatActor",
      "domain_of": [
        "StixThreatActor"
      ],
      "range": "string",
      "any_of": [
        {
          "range": "StixThreatActorSophistication",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "personal_motivations",
      "definition_uri": "https://w3id.org/lmodel/stix/personal_motivations",
      "description": "The personal reasons, motivations, or purposes of the Threat Actor regardless of organizational goals. Open Vocab - attack-motivation-ov.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/personal_motivations"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/personal_motivations",
      "owner": "StixThreatActor",
      "domain_of": [
        "StixThreatActor"
      ],
      "range": "string",
      "multivalued": true,
      "minimum_cardinality": 1,
      "any_of": [
        {
          "range": "StixAttackMotivation",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "tool_types",
      "definition_uri": "https://w3id.org/lmodel/stix/tool_types",
      "description": "The kind(s) of tool(s) being described. Open Vocab - tool-type-ov.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/tool_types"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/tool_types",
      "owner": "StixTool",
      "domain_of": [
        "StixTool"
      ],
      "range": "string",
      "multivalued": true,
      "minimum_cardinality": 1,
      "any_of": [
        {
          "range": "StixToolType",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "tool_version",
      "definition_uri": "https://w3id.org/lmodel/stix/tool_version",
      "description": "The version identifier associated with the tool.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sdo",
      "mappings": [
        "https://w3id.org/lmodel/stix/tool_version"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/tool_version",
      "owner": "StixTool",
      "domain_of": [
        "StixTool"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "relationship_type",
      "definition_uri": "https://w3id.org/lmodel/stix/relationship_type",
      "description": "The name used to identify the type of relationship.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/relationship_type"
      ],
      "close_mappings": [
        "https://ontology.unifiedcyberontology.org/uco/core/kindOfRelationship"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/relationship_type",
      "owner": "StixRelationship",
      "domain_of": [
        "StixRelationship"
      ],
      "range": "string",
      "pattern": "^[a-z0-9\\-]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "source_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/source_ref",
      "description": "The ID of the source (from) object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/source_ref"
      ],
      "close_mappings": [
        "https://ontology.unifiedcyberontology.org/uco/core/source"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/source_ref",
      "owner": "StixRelationship",
      "domain_of": [
        "StixRelationship"
      ],
      "range": "StixObject",
      "pattern": "^(?!(relationship|sighting|bundle|marking-definition|language-content)--)[a-z][a-z0-9-]+[a-z0-9]--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "any_of": [
        {
          "range": "StixDomainObject",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixCyberObservableObject",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "target_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/target_ref",
      "description": "The ID of the target (to) object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/target_ref"
      ],
      "close_mappings": [
        "https://ontology.unifiedcyberontology.org/uco/core/target"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/target_ref",
      "owner": "StixRelationship",
      "domain_of": [
        "StixRelationship"
      ],
      "range": "StixObject",
      "pattern": "^(?!(relationship|sighting|bundle|marking-definition|language-content)--)[a-z][a-z0-9-]+[a-z0-9]--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "any_of": [
        {
          "range": "StixDomainObject",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixCyberObservableObject",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "start_time",
      "definition_uri": "https://w3id.org/lmodel/stix/start_time",
      "description": "This optional timestamp represents the earliest time at which the Relationship between the objects exists. If this property is a future timestamp, at the time the updated property is defined, then this represents an estimate by the producer of the intelligence of the earliest time at which relationship will be asserted to be true.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/start_time"
      ],
      "close_mappings": [
        "https://ontology.unifiedcyberontology.org/uco/core/startTime"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/start_time",
      "owner": "StixRelationship",
      "domain_of": [
        "StixRelationship"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "stop_time",
      "definition_uri": "https://w3id.org/lmodel/stix/stop_time",
      "description": "The latest time at which the Relationship between the objects exists. If this property is a future timestamp, at the time the updated property is defined, then this represents an estimate by the producer of the intelligence of the latest time at which relationship will be asserted to be true.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/stop_time"
      ],
      "close_mappings": [
        "https://ontology.unifiedcyberontology.org/uco/core/endTime"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/stop_time",
      "owner": "StixRelationship",
      "domain_of": [
        "StixRelationship"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "count",
      "definition_uri": "https://w3id.org/lmodel/stix/count",
      "description": "This is an integer between 0 and 999,999,999 inclusive and represents the number of times the object was sighted.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/count"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/count",
      "owner": "StixSighting",
      "domain_of": [
        "StixSighting"
      ],
      "range": "integer",
      "minimum_value": 0,
      "maximum_value": 999999999,
      "@type": "SlotDefinition"
    },
    {
      "name": "sighting_of_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/sighting_of_ref",
      "description": "An ID reference to the object that has been sighted.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/sighting_of_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/sighting_of_ref",
      "owner": "StixSighting",
      "domain_of": [
        "StixSighting"
      ],
      "range": "StixDomainObject",
      "pattern": "^(?!(relationship|sighting|bundle|marking-definition|language-content)--)[a-z][a-z0-9-]+[a-z0-9]--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "observed_data_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/observed_data_refs",
      "description": "A list of ID references to the Observed Data objects that contain the raw cyber data for this Sighting.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/observed_data_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/observed_data_refs",
      "owner": "StixSighting",
      "domain_of": [
        "StixSighting"
      ],
      "range": "StixObservedData",
      "multivalued": true,
      "pattern": "^observed-data--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "where_sighted_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/where_sighted_refs",
      "description": "A list of ID references to the Identity or Location objects describing the entities or types of entities that saw the sighting.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/where_sighted_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/where_sighted_refs",
      "owner": "StixSighting",
      "domain_of": [
        "StixSighting"
      ],
      "range": "StixDomainObject",
      "multivalued": true,
      "pattern": "^(identity|location)--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "any_of": [
        {
          "range": "StixIdentity",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "StixLocation",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "summary",
      "definition_uri": "https://w3id.org/lmodel/stix/summary",
      "description": "The summary property indicates whether the Sighting should be considered summary data.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sro",
      "mappings": [
        "https://w3id.org/lmodel/stix/summary"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/summary",
      "owner": "StixSighting",
      "domain_of": [
        "StixSighting"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "mime_type",
      "definition_uri": "https://w3id.org/lmodel/stix/mime_type",
      "description": "The value of this property MUST be a valid MIME type as specified in the IANA Media Types registry.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/mime_type"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/mime_type",
      "owner": "StixFile",
      "domain_of": [
        "StixArtifact",
        "StixFile"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "payload_bin",
      "definition_uri": "https://w3id.org/lmodel/stix/payload_bin",
      "description": "Specifies the binary data contained in the artifact as a base64-encoded string.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/payload_bin"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/payload_bin",
      "owner": "StixArtifact",
      "domain_of": [
        "StixArtifact"
      ],
      "range": "stix_binary",
      "@type": "SlotDefinition"
    },
    {
      "name": "encryption_algorithm",
      "definition_uri": "https://w3id.org/lmodel/stix/encryption_algorithm",
      "description": "If the artifact is encrypted, specifies the type of encryption algorithm the binary data (either via payload_bin or url) is encoded in.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/encryption_algorithm"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/encryption_algorithm",
      "owner": "StixArtifact",
      "domain_of": [
        "StixArtifact"
      ],
      "range": "StixEncryptionAlgorithm",
      "@type": "SlotDefinition"
    },
    {
      "name": "decryption_key",
      "definition_uri": "https://w3id.org/lmodel/stix/decryption_key",
      "description": "Specifies the decryption key for the encrypted binary data (either via payload_bin or url).",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/decryption_key"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/decryption_key",
      "owner": "StixArtifact",
      "domain_of": [
        "StixArtifact"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "number",
      "definition_uri": "https://w3id.org/lmodel/stix/number",
      "description": "Specifies the number assigned to the AS. Such assignments are typically performed by a Regional Internet Registries (RIR).",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/number"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/number",
      "owner": "StixAutonomousSystem",
      "domain_of": [
        "StixAutonomousSystem"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "rir",
      "definition_uri": "https://w3id.org/lmodel/stix/rir",
      "description": "Specifies the name of the Regional Internet Registry (RIR) that assigned the number to the AS.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/rir"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/rir",
      "owner": "StixAutonomousSystem",
      "domain_of": [
        "StixAutonomousSystem"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "path",
      "definition_uri": "https://w3id.org/lmodel/stix/path",
      "description": "A path, as it was observed.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/path"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/path",
      "owner": "StixDirectory",
      "domain_of": [
        "StixDirectory"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "path_enc",
      "definition_uri": "https://w3id.org/lmodel/stix/path_enc",
      "description": "Specifies the observed encoding for the path.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/path_enc"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/path_enc",
      "owner": "StixDirectory",
      "domain_of": [
        "StixDirectory"
      ],
      "range": "string",
      "pattern": "^[a-zA-Z0-9/\\.+_:-]{2,250}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "ctime",
      "definition_uri": "https://w3id.org/lmodel/stix/ctime",
      "description": "The time at which the object was created.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
