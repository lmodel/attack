      "pattern": "^directory--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "content_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/content_ref",
      "description": "Specifies the content of the file, represented as an Artifact Object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
