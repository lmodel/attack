      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/start"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/start",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "end",
      "definition_uri": "https://w3id.org/lmodel/stix/end",
      "description": "Specifies the date/time the network traffic ended, if known.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/end"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/end",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "src_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/src_ref",
      "description": "Specifies the source of the network traffic, as a reference to an Observable Object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
