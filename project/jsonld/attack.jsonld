      ],
      "range": "StixArtifact",
      "pattern": "^artifact--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "dst_payload_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/dst_payload_ref",
      "description": "Specifies the bytes sent from the source to the destination.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
