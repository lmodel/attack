    {
      "name": "StixMarkingDefinition",
      "definition_uri": "https://w3id.org/lmodel/stix/StixMarkingDefinition",
      "annotations": [
        {
          "tag": "stix_type",
          "value": "marking-definition",
          "@type": "Annotation"
        }
      ],
      "description": "A marking definition: a statement, a Traffic Light Protocol (TLP) level or another marking that applies to the objects that reference it.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_core",
      "close_mappings": [
        "uco-marking:MarkingDefinition"
      ],
      "is_a": "StixObject",
      "slots": [
        "object_marking_refs",
        "granular_markings",
        "extensions",
        "created_by_ref",
        "StixMarkingDefinition_created",
        "external_references",
        "name",
        "definition_type",
        "definition",
        "StixMarkingDefinition_id",
        "StixMarkingDefinition_type",
        "StixMarkingDefinition_spec_version"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/stix/StixMarkingDefinition",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "extensions",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "definition",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "definition_type",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Without extensions, a marking definition states its definition and definition type.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
