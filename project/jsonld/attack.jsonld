      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "StixMimePart",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "size",
      "definition_uri": "https://w3id.org/lmodel/stix/size",
      "description": "A size in bytes, as a non-negative integer.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/size"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/size",
      "owner": "StixWindowsPeSection",
      "domain_of": [
        "StixFile",
        "StixAlternateDataStream",
        "StixWindowsPeSection"
      ],
      "range": "integer",
      "minimum_value": 0,
      "@type": "SlotDefinition"
    },
    {
      "name": "name_enc",
      "definition_uri": "https://w3id.org/lmodel/stix/name_enc",
      "description": "Specifies the observed encoding for the name of the file.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/name_enc"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/name_enc",
      "owner": "StixFile",
      "domain_of": [
