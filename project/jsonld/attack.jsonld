      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/stix/StixExtensionDefinition",
      "@type": "ClassDefinition"
    },
    {
      "name": "StixExternalReference",
      "definition_uri": "https://w3id.org/lmodel/stix/StixExternalReference",
      "description": "External references are used to describe pointers to information represented outside of STIX.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_core",
      "close_mappings": [
        "uco-core:ExternalReference"
      ],
      "slots": [
        "StixExternalReference_source_name",
        "description",
        "url",
        "hashes",
        "external_id"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/stix/StixExternalReference",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "source_name",
                "equals_string": "cve",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "external_id",
                "required": true,
                "pattern": "^CVE-\\d{4}-(0\\d{3}|[1-9]\\d{3,})$",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A reference to the CVE list names a CVE identifier.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "source_name",
                "equals_string": "capec",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "external_id",
                "required": true,
                "pattern": "^CAPEC-\\d+$",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A reference to CAPEC names a CAPEC identifier.",
          "@type": "ClassRule"
        }
      ],
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "external_id",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "description",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "url",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
