      ],
      "range": "StixCyberObservableObject",
      "multivalued": true,
      "pattern": "^[a-z][a-z0-9-]+[a-z0-9]--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "value",
      "definition_uri": "https://w3id.org/lmodel/stix/value",
      "description": "The value of the observable, in the form each class states.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/value"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/value",
      "owner": "StixUrl",
