    {
      "name": "StixArtifact",
      "definition_uri": "https://w3id.org/lmodel/stix/StixArtifact",
      "annotations": [
        {
          "tag": "stix_type",
          "value": "artifact",
          "@type": "Annotation"
        }
      ],
      "description": "The Artifact Object permits capturing an array of bytes (8-bits), as a base64-encoded string string, or linking to a file-like payload.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "is_a": "StixCyberObservableObject",
      "slots": [
        "spec_version",
        "object_marking_refs",
        "granular_markings",
        "extensions",
        "defanged",
        "StixArtifact_mime_type",
        "payload_bin",
        "url",
        "hashes",
        "encryption_algorithm",
        "decryption_key",
        "StixArtifact_id",
        "StixArtifact_type"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/stix/StixArtifact",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "payload_bin",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "url",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "payload_bin and url exclude each other.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "url",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "hashes",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An artifact given by url carries its hashes.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "decryption_key",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "encryption_algorithm",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A decryption key needs an encryption algorithm.",
          "@type": "ClassRule"
        }
      ],
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "payload_bin",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "url",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
