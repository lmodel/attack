      "domain_of": [
        "StixEmailAddress",
        "StixUserAccount",
        "StixWindowsServiceExtension"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "belongs_to_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/belongs_to_ref",
