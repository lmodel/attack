      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_hidden",
      "definition_uri": "https://w3id.org/lmodel/stix/is_hidden",
      "description": "Specifies whether the process is hidden.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/is_hidden"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/is_hidden",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "pid",
      "definition_uri": "https://w3id.org/lmodel/stix/pid",
      "description": "Specifies the Process ID, or PID, of the process.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/pid"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/pid",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "created_time",
      "definition_uri": "https://w3id.org/lmodel/stix/created_time",
      "description": "Specifies the date/time at which the process was created.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/created_time"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/created_time",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "cwd",
      "definition_uri": "https://w3id.org/lmodel/stix/cwd",
      "description": "Specifies the current working directory of the process.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/cwd"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/cwd",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "command_line",
      "definition_uri": "https://w3id.org/lmodel/stix/command_line",
      "description": "Specifies the full command line used in executing the process, including the process name (which may be specified individually via the binary_ref.name property) and any arguments.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/command_line"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/command_line",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "environment_variables",
      "definition_uri": "https://w3id.org/lmodel/stix/environment_variables",
      "description": "Specifies the list of environment variables associated with the process as a dictionary.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/environment_variables"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/environment_variables",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "StixDictionary",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "opened_connection_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/opened_connection_refs",
      "description": "Specifies the list of network connections opened by the process, as a reference to one or more Network Traffic Objects.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/opened_connection_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/opened_connection_refs",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "StixNetworkTraffic",
      "multivalued": true,
      "pattern": "^network-traffic--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "creator_user_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/creator_user_ref",
      "description": "A reference to the user account that created the object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/creator_user_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/creator_user_ref",
      "owner": "StixWindowsRegistryKey",
      "domain_of": [
        "StixProcess",
        "StixWindowsRegistryKey"
      ],
      "range": "StixUserAccount",
      "pattern": "^user-account--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "image_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/image_ref",
      "description": "Specifies the executable binary that was executed as the process image, as a reference to a File Object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/image_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/image_ref",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "StixFile",
      "pattern": "^file--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "parent_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/parent_ref",
      "description": "Specifies the other process that spawned (i.e. is the parent of) this one, as represented by a Process Object.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/parent_ref"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/parent_ref",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "StixProcess",
      "pattern": "^process--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "child_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/child_refs",
      "description": "Specifies the other processes that were spawned by (i.e. children of) this process, as a reference to one or more other Process Objects.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/child_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/child_refs",
      "owner": "StixProcess",
      "domain_of": [
        "StixProcess"
      ],
      "range": "StixProcess",
      "multivalued": true,
      "pattern": "^process--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "cpe",
      "definition_uri": "https://w3id.org/lmodel/stix/cpe",
      "description": "Specifies the Common Platform Enumeration (CPE) entry for the software, if available. The value for this property MUST be a CPE v2.3 entry from the official NVD CPE Dictionary.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/cpe"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/cpe",
      "owner": "StixSoftware",
      "domain_of": [
        "StixSoftware"
      ],
      "range": "string",
      "pattern": "cpe:2\\.3:[aho\\*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-\\._]|(\\\\[\\\\\\*\\?!\\x22#$$%&\\x27\\(\\)\\+,/:;<=>@\\[\\]\\^`\\{\\|}~]))+(\\?*|\\*?))|[\\*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[\\*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-\\._]|(\\\\[\\\\\\*\\?!\\x22#$$%&\\x27\\(\\)\\+,/:;<=>@\\[\\]\\^`\\{\\|}~]))+(\\?*|\\*?))|[\\*\\-])){4}",
      "@type": "SlotDefinition"
    },
    {
      "name": "swid",
      "definition_uri": "https://w3id.org/lmodel/stix/swid",
      "description": "Specifies the Software Identification (SWID) Tags entry for the software, if available.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/swid"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/swid",
      "owner": "StixSoftware",
      "domain_of": [
        "StixSoftware"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "languages",
      "definition_uri": "https://w3id.org/lmodel/stix/languages",
      "description": "Specifies the languages supported by the software. The value of each list member MUST be an RFC 5646 language code. ISO 639-2 codes are accepted for backward compatibility.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/languages"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/languages",
      "owner": "StixSoftware",
      "domain_of": [
        "StixSoftware"
      ],
      "range": "string",
      "multivalued": true,
      "pattern": "^([a-z]{2}(-[A-Z]{2})?(-[a-z]{4})?(-[A-Z]{2}|[0-9]{3})?(-[a-z0-9]{5,8}|[0-9][a-z0-9]{3})*(-[a-z0-9]{1,8})*|[a-z]{3})$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "vendor",
      "definition_uri": "https://w3id.org/lmodel/stix/vendor",
      "description": "Specifies the name of the vendor of the software.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/vendor"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/vendor",
      "owner": "StixSoftware",
      "domain_of": [
        "StixSoftware"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "user_id",
      "definition_uri": "https://w3id.org/lmodel/stix/user_id",
      "description": "Specifies the identifier of the account.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/user_id"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/user_id",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "credential",
      "definition_uri": "https://w3id.org/lmodel/stix/credential",
      "description": "Specifies a cleartext credential. This is only intended to be used in capturing metadata from malware analysis (e.g., a hard-coded domain administrator password that the malware attempts to use for lateral movement) and SHOULD NOT be used for sharing of PII.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/credential"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/credential",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "account_login",
      "definition_uri": "https://w3id.org/lmodel/stix/account_login",
      "description": "Specifies the account login string, used in cases where the user_id property specifies something other than what a user would type when they login.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/account_login"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/account_login",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "account_type",
      "definition_uri": "https://w3id.org/lmodel/stix/account_type",
      "description": "Specifies the type of the account. This is an open vocabulary and values SHOULD come from the account-type-ov vocabulary.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/account_type"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/account_type",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "string",
      "any_of": [
        {
          "range": "StixAccountType",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "is_service_account",
      "definition_uri": "https://w3id.org/lmodel/stix/is_service_account",
      "description": "Indicates that the account is associated with a network service or system process (daemon), not a specific individual.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/is_service_account"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/is_service_account",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_privileged",
      "definition_uri": "https://w3id.org/lmodel/stix/is_privileged",
      "description": "Specifies that the account has elevated privileges (i.e., in the case of root on Unix or the Windows Administrator account).",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/is_privileged"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/is_privileged",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "can_escalate_privs",
      "definition_uri": "https://w3id.org/lmodel/stix/can_escalate_privs",
      "description": "Specifies that the account has the ability to escalate privileges (i.e., in the case of sudo on Unix or a Windows Domain Admin account).",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/can_escalate_privs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/can_escalate_privs",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_disabled",
      "definition_uri": "https://w3id.org/lmodel/stix/is_disabled",
      "description": "Specifies if the account is disabled.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/is_disabled"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/is_disabled",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "account_created",
      "definition_uri": "https://w3id.org/lmodel/stix/account_created",
      "description": "Specifies when the account was created.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/account_created"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/account_created",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "account_expires",
      "definition_uri": "https://w3id.org/lmodel/stix/account_expires",
      "description": "Specifies the expiration date of the account.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/account_expires"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/account_expires",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "credential_last_changed",
      "definition_uri": "https://w3id.org/lmodel/stix/credential_last_changed",
      "description": "Specifies when the account credential was last changed.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/credential_last_changed"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/credential_last_changed",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "account_first_login",
      "definition_uri": "https://w3id.org/lmodel/stix/account_first_login",
      "description": "Specifies when the account was first accessed.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/account_first_login"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/account_first_login",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "account_last_login",
      "definition_uri": "https://w3id.org/lmodel/stix/account_last_login",
      "description": "Specifies when the account was last accessed.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/account_last_login"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/account_last_login",
      "owner": "StixUserAccount",
      "domain_of": [
        "StixUserAccount"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "key",
      "definition_uri": "https://w3id.org/lmodel/stix/key",
      "description": "Specifies the full registry key including the hive.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/key"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/key",
      "owner": "StixWindowsRegistryKey",
      "domain_of": [
        "StixWindowsRegistryKey"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "values",
      "definition_uri": "https://w3id.org/lmodel/stix/values",
      "description": "Specifies the values found under the registry key.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/values"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/values",
      "owner": "StixWindowsRegistryKey",
      "domain_of": [
        "StixWindowsRegistryKey"
      ],
      "range": "StixWindowsRegistryValue",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "modified_time",
      "definition_uri": "https://w3id.org/lmodel/stix/modified_time",
      "description": "Specifies the last date/time that the registry key was modified.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/modified_time"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/modified_time",
      "owner": "StixWindowsRegistryKey",
      "domain_of": [
        "StixWindowsRegistryKey"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "number_of_subkeys",
      "definition_uri": "https://w3id.org/lmodel/stix/number_of_subkeys",
      "description": "Specifies the number of subkeys contained under the registry key.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/number_of_subkeys"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/number_of_subkeys",
      "owner": "StixWindowsRegistryKey",
      "domain_of": [
        "StixWindowsRegistryKey"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "is_self_signed",
      "definition_uri": "https://w3id.org/lmodel/stix/is_self_signed",
      "description": "Specifies whether the certificate is self-signed, i.e., whether it is signed by the same entity whose identity it certifies.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/is_self_signed"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/is_self_signed",
      "owner": "StixX509Certificate",
      "domain_of": [
        "StixX509Certificate"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
