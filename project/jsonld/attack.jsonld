      ],
      "slot_uri": "https://w3id.org/lmodel/stix/ctime",
      "owner": "StixFile",
      "domain_of": [
        "StixDirectory",
        "StixFile"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "mtime",
      "definition_uri": "https://w3id.org/lmodel/stix/mtime",
      "description": "The time at which the object was last written to.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/mtime"
