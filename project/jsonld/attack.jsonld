        }
      ],
      "description": "The marking definition types that STIX 2.1 defines, statement and tlp. A slot that names it also takes any other string, as the JSON schemas do.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_vocabularies",
      "permissible_values": [
        {
          "text": "statement"
        },
        {
          "text": "tlp"
        }
      ]
    }
  ],
  "slots": [
    {
      "name": "x_mitre_attack_spec_version",
      "definition_uri": "https://w3id.org/lmodel/attack/x_mitre_attack_spec_version",
      "description": "The version of the ATT&CK specification the object follows, as MAJOR.MINOR.PATCH. Without it, an object is read as version 2.0.0.",
      "from_schema": "https://w3id.org/lmodel/attack",
      "mappings": [
        "https://w3id.org/lmodel/attack/x_mitre_attack_spec_version"
      ],
      "slot_uri": "https://w3id.org/lmodel/attack/x_mitre_attack_spec_version",
      "owner": "AttackIdentity",
      "domain_of": [
        "AttackTechnique",
        "AttackTactic",
        "AttackGroup",
        "AttackCampaign",
        "AttackMalware",
        "AttackTool",
        "AttackMitigation",
        "AttackMatrix",
        "AttackCollection",
        "AttackAsset",
        "AttackDataSource",
        "AttackDataComponent",
        "AttackDetectionStrategy",
        "AttackAnalytic",
        "AttackRelationship",
        "AttackIdentity"
      ],
      "range": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "@type": "SlotDefinition"
    },
    {
      "name": "x_mitre_version",
      "definition_uri": "https://w3id.org/lmodel/attack/x_mitre_version",
