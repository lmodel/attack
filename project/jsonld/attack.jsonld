      "mappings": [
        "https://w3id.org/lmodel/stix/atime"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/atime",
      "owner": "StixFile",
      "domain_of": [
        "StixDirectory",
        "StixFile"
      ],
      "range": "stix_timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "contains_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/contains_refs",
      "description": "References to other cyber-observable objects that this one contains.",
