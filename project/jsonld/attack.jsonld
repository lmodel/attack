      "pattern": "^artifact--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "belongs_to_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/belongs_to_refs",
