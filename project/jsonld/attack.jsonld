      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "dst_byte_count",
      "definition_uri": "https://w3id.org/lmodel/stix/dst_byte_count",
      "description": "Specifies the number of bytes sent from the destination to the source.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/dst_byte_count"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/dst_byte_count",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "src_packets",
      "definition_uri": "https://w3id.org/lmodel/stix/src_packets",
      "description": "Specifies the number of packets sent from the source to the destination.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/src_packets"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/src_packets",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "dst_packets",
      "definition_uri": "https://w3id.org/lmodel/stix/dst_packets",
      "description": "Specifies the number of packets sent destination to the source.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/dst_packets"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/dst_packets",
      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "integer",
      "@type": "SlotDefinition"
    },
    {
      "name": "ipfix",
      "definition_uri": "https://w3id.org/lmodel/stix/ipfix",
