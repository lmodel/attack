        "content_disposition"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/stix/StixMimePart",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "body",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "body_raw_ref",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "body and body_raw_ref exclude each other.",
          "@type": "ClassRule"
        }
      ],
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "body",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "body_raw_ref",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
