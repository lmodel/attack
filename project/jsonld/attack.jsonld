      "@type": "SlotDefinition"
    },
    {
      "name": "email_date",
      "definition_uri": "https://w3id.org/lmodel/stix/email_date",
      "description": "Specifies the date/time that the email message was sent.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
