      "owner": "StixNetworkTraffic",
      "domain_of": [
        "StixNetworkTraffic"
      ],
      "range": "StixDictionary",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "src_payload_ref",
      "definition_uri": "https://w3id.org/lmodel/stix/src_payload_ref",
      "description": "Specifies the bytes sent from the source to the destination.",
