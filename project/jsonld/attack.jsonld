    {
      "name": "AttackRelationship",
      "definition_uri": "https://w3id.org/lmodel/attack/AttackRelationship",
      "annotations": [
        {
          "tag": "stix_type",
          "value": "relationship",
          "@type": "Annotation"
        }
      ],
      "description": "A relationship between two ATT&CK objects, of one of the seven types ATT&CK uses. Its rules say which types of object each type of relationship may join.",
      "from_schema": "https://w3id.org/lmodel/attack",
      "is_a": "StixRelationship",
      "slots": [
        "object_marking_refs",
        "granular_markings",
        "extensions",
        "created_by_ref",
        "StixCommonObject_created",
        "StixCommonObject_modified",
        "revoked",
        "labels",
        "confidence",
        "lang",
        "external_references",
        "StixCommonObject_spec_version",
        "description",
        "StixRelationship_source_ref",
        "StixRelationship_target_ref",
        "start_time",
        "stop_time",
        "StixRelationship_id",
        "StixRelationship_type",
        "AttackRelationship_x_mitre_attack_spec_version",
        "x_mitre_deprecated",
        "x_mitre_old_attack_id",
        "AttackRelationship_x_mitre_modified_by_ref",
        "AttackRelationship_relationship_type"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/attack/AttackRelationship",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "uses",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^(intrusion-set|campaign|malware|tool)--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^(attack-pattern|malware|tool)--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A group, a campaign or software uses a technique or software.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "uses",
                "@type": "SlotDefinition"
              },
              {
                "name": "source_ref",
                "pattern": "^(malware|tool)--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "target_ref",
                "pattern": "^attack-pattern--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Software uses techniques, not other software.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "mitigates",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^course-of-action--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^attack-pattern--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A mitigation mitigates a technique.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "subtechnique-of",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^attack-pattern--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^attack-pattern--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A sub-technique belongs to a technique.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "detects",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^(x-mitre-detection-strategy|x-mitre-data-component)--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^attack-pattern--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A detection strategy, or a data component as before detection strategies, detects a technique.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "attributed-to",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^campaign--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^intrusion-set--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A campaign is attributed to a group.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "targets",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^attack-pattern--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^x-mitre-asset--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A technique targets an asset.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "relationship_type",
                "equals_string": "revoked-by",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "source_ref",
                "pattern": "^(attack-pattern|campaign|course-of-action|intrusion-set|malware|tool|x-mitre-asset|x-mitre-data-component)--",
                "@type": "SlotDefinition"
              },
              {
                "name": "target_ref",
                "pattern": "^(attack-pattern|campaign|course-of-action|intrusion-set|malware|tool|x-mitre-asset|x-mitre-data-component)--",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An object that can be revoked is replaced by another such object. The ADM asks for one of the same type; the v20.0 data has a malware revoked by a tool, so the rule does not.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
