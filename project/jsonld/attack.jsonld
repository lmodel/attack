      "name": "AttackTechnique",
      "definition_uri": "https://w3id.org/lmodel/attack/AttackTechnique",
      "annotations": [
        {
          "tag": "stix_type",
          "value": "attack-pattern",
          "@type": "Annotation"
        },
        {
          "tag": "attack_id_pattern",
          "value": "^T\\d{4}(\\.\\d{3})?$",
          "@type": "Annotation"
        }
      ],
      "description": "A technique: how an adversary achieves a tactic's goal. A sub-technique is a technique too, with x_mitre_is_subtechnique set and a subtechnique-of relationship to its parent. Its ATT&CK ID is T and four digits, and a sub-technique's adds a full stop and three digits.",
      "from_schema": "https://w3id.org/lmodel/attack",
      "is_a": "StixAttackPattern",
