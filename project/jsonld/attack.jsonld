      "mappings": [
        "https://w3id.org/lmodel/stix/body"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/body",
      "owner": "StixMimePart",
      "domain_of": [
        "StixEmailMessage",
        "StixMimePart"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "body_multipart",
      "definition_uri": "https://w3id.org/lmodel/stix/body_multipart",
      "description": "Specifies a list of the MIME parts that make up the email body. This property MAY only be used if is_multipart is true.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/body_multipart"
