      "range": "StixEmailAddress",
      "multivalued": true,
      "pattern": "^email-addr--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "cc_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/cc_refs",
      "description": "Specifies the mailboxes that are 'CC:' recipients of the email message.",
      "from_schema": "https://w3id.org/lmodel/stix/stix_sco",
      "mappings": [
        "https://w3id.org/lmodel/stix/cc_refs"
      ],
      "slot_uri": "https://w3id.org/lmodel/stix/cc_refs",
      "owner": "StixEmailMessage",
      "domain_of": [
        "StixEmailMessage"
      ],
      "range": "StixEmailAddress",
      "multivalued": true,
      "pattern": "^email-addr--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "bcc_refs",
      "definition_uri": "https://w3id.org/lmodel/stix/bcc_refs",
