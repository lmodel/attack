        "labels",
        "confidence",
        "lang",
        "external_references",
        "StixCommonObject_spec_version",
        "description",
        "name",
        "latitude",
        "longitude",
        "precision",
        "region",
        "country",
        "administrative_area",
        "city",
        "street_address",
        "postal_code",
        "StixLocation_id",
        "StixLocation_type"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/stix/StixLocation",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "latitude",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "longitude",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A latitude needs a longitude.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "longitude",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "latitude",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A longitude needs a latitude.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "precision",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "latitude",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "longitude",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A precision needs a latitude and a longitude.",
          "@type": "ClassRule"
        }
      ],
      "any_of": [
        {
          "slot_conditions": [
            {
              "name": "region",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "country",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "latitude",
              "required": true,
              "@type": "SlotDefinition"
            },
            {
              "name": "longitude",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
