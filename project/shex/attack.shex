          stix:created_by_ref @stix:StixIdentity ;
          stix:object_marking_refs @stix:StixMarkingDefinition + ;
          stix:revoked @linkml:Boolean ;
          stix:external_references @stix:StixExternalReference + ;
          stix:aliases @linkml:String + ;
          stix:first_seen @stix:StixTimestamp ;
          stix:last_seen @stix:StixTimestamp
       ) ;
       rdf:type [ <AttackCampaign> ]
    )
}

