             <https://w3id.org/lmodel/attack/AttackAssetSector#Water%20and%20Wastewater> ] * ;
          <x_mitre_related_assets> @<AttackRelatedAsset> * ;
          stix:type @linkml:String ;
          stix:created_by_ref @stix:StixIdentity ;
          stix:object_marking_refs @stix:StixMarkingDefinition + ;
          stix:external_references @stix:StixExternalReference +
       ) ;
       rdf:type [ <AttackAsset> ]
    )
}

<AttackBundle> CLOSED {
    (  $<AttackBundle_tes> (  &stix:StixBundle_tes ;
          rdf:type [ stix:StixBundle ] ?
       ) ;
       rdf:type [ <AttackBundle> ]
    )
}

<AttackCampaign> CLOSED {
    (  $<AttackCampaign_tes> (  &stix:StixCampaign_tes ;
